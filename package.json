{
  "name": "reticle",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "test": "pnpm -r --if-present test",
    "test:contracts": "cd contracts && forge test",
    "sync": "tsx scripts/sync-web-data.ts",
    "embed": "tsx scripts/build-embed.ts",
    "build": "pnpm sync && pnpm embed && pnpm -F web build",
    "phase0": "tsx scripts/phase0.ts",
    "bench": "tsx scripts/bench.ts",
    "verify": "tsx scripts/verify.ts",
    "check:facts": "tsx scripts/check-facts.ts",
    "typecheck": "tsc -p tsconfig.json && pnpm -F web exec tsc --noEmit"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.10.0",
    "playwright": "^1.64.0",
    "terser": "^5.51.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "viem": "^2.21.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@reticle/chain": "workspace:*",
    "@reticle/compile": "workspace:*"
  }
}
